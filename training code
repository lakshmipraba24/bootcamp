import os
import numpy as np
import librosa
import pandas as pd
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import LabelEncoder
import tensorflow as tf
from tensorflow.keras.models import Sequential
from tensorflow.keras.layers import (
    Conv1D, MaxPooling1D, Flatten, Dense, Dropout,
    Bidirectional, LSTM, BatchNormalization
)
import matplotlib.pyplot as plt
from sklearn.metrics import classification_report, confusion_matrix
import seaborn as sns

# ─── CONSTANTS ─────────────────────────────────────────────────────────────────
MAX_PAD_LEN = 130   # ~3.0 seconds of audio at 16kHz with 512 hop length
N_MFCC      = 40    # Number of MFCC features per time frame
labels_file  = "labels.xlsx"
augmented_dir = "augmented_massive"

# ─── 1. LOAD LABELS ────────────────────────────────────────────────────────────
print("1. Loading labels...")
df = pd.read_excel(labels_file)

label_map = {}
for _, row in df.iterrows():
    if pd.isna(row['spoken_phrase']) or not str(row['spoken_phrase']).strip():
        continue
    phrase    = str(row['spoken_phrase']).strip().lower()
    base_file = str(row['base_filename']).strip()
    label_map[base_file] = phrase

print(f"   Loaded {len(label_map)} base labels.")

# ─── 2. FEATURE EXTRACTION (CRNN-aware: keep time axis!) ──────────────────────
def parse_mfcc(file_path):
    """Extract MFCC and pad/truncate to MAX_PAD_LEN time steps."""
    y, sr = librosa.load(file_path, sr=16000)
    mfccs = librosa.feature.mfcc(y=y, sr=sr, n_mfcc=N_MFCC)  # shape: (40, T)
    mfccs = mfccs.T                                             # shape: (T, 40)

    # Pad with zeros if too short, truncate if too long
    if mfccs.shape[0] < MAX_PAD_LEN:
        pad_width = MAX_PAD_LEN - mfccs.shape[0]
        mfccs = np.pad(mfccs, ((0, pad_width), (0, 0)), mode='constant')
    else:
        mfccs = mfccs[:MAX_PAD_LEN, :]

    return mfccs  # shape: (130, 40)

X = []
y_labels = []

print(f"2. Extracting CRNN-compatible MFCC features from '{augmented_dir}'...")
print("   This might take a few minutes as it processes ~1400 files...")

file_list = os.listdir(augmented_dir)
for i, file in enumerate(file_list):
    if i % 100 == 0:
        print(f"   Processed {i}/{len(file_list)} files...")

    if file.endswith(".wav"):
        matched_base = None
        for base in label_map.keys():
            if file.startswith(base):
                matched_base = base
                break

        if matched_base:
            file_path = os.path.join(augmented_dir, file)
            try:
                mfcc = parse_mfcc(file_path)
                X.append(mfcc)
                y_labels.append(label_map[matched_base])
            except Exception as e:
                print(f"   Error processing {file}: {e}")

X     = np.array(X)      # shape: (N, 130, 40)
y_str = np.array(y_labels)

if len(X) == 0:
    print("FATAL ERROR: No features extracted. Did the augmentations complete?")
    exit(1)

# ─── 3. LABEL ENCODING ────────────────────────────────────────────────────────
print("3. Encoding Labels...")
encoder     = LabelEncoder()
y_encoded   = encoder.fit_transform(y_str)
num_classes = len(encoder.classes_)
y_categorical = tf.keras.utils.to_categorical(y_encoded, num_classes)

print(f"   Successfully processed {len(X)} samples across {num_classes} phrases.")
for i, cls in enumerate(encoder.classes_):
    print(f"   [{i}] {cls}")

with open("class_dictionary.txt", "w") as f:
    for i, cls in enumerate(encoder.classes_):
        f.write(f"{i}:{cls}\n")
print("   Saved class_dictionary.txt")

# ─── 4. TRAIN / TEST SPLIT ────────────────────────────────────────────────────
print("4. Preparing Train/Test splits...")
X_train, X_test, y_train, y_test = train_test_split(
    X, y_categorical, test_size=0.2, random_state=42
)
# X shape is already (N, 130, 40) — perfect for CRNN, no extra expand_dims needed!

# ─── 5. CRNN MODEL ARCHITECTURE ───────────────────────────────────────────────
print("5. Building CRNN Model (Conv1D + Bidirectional LSTM)...")
model = Sequential([
    # --- Convolutional Block (extract local patterns / phonemes) ---
    Conv1D(filters=64, kernel_size=5, activation='relu', padding='same',
           input_shape=(MAX_PAD_LEN, N_MFCC)),
    BatchNormalization(),
    MaxPooling1D(pool_size=2),
    Dropout(0.2),

    Conv1D(filters=128, kernel_size=5, activation='relu', padding='same'),
    BatchNormalization(),
    MaxPooling1D(pool_size=2),
    Dropout(0.2),

    # --- Recurrent Block (model temporal sequence of phonemes -> words) ---
    Bidirectional(LSTM(128, return_sequences=False)),
    Dropout(0.3),

    # --- Classifier Head ---
    Dense(128, activation='relu'),
    Dropout(0.3),
    Dense(num_classes, activation='softmax')
])

model.compile(
    loss='categorical_crossentropy',
    optimizer=tf.keras.optimizers.Adam(learning_rate=0.001),
    metrics=['accuracy']
)
model.summary()

# ─── 6. TRAIN MODEL ───────────────────────────────────────────────────────────
print("6. Training CRNN (Epochs: 40)...")
early_stop = tf.keras.callbacks.EarlyStopping(
    monitor='val_loss', patience=7, restore_best_weights=True
)
history = model.fit(
    X_train, y_train,
    batch_size=32,
    epochs=40,
    validation_data=(X_test, y_test),
    callbacks=[early_stop]
)

# ─── 7. PLOT TRAINING CURVES ──────────────────────────────────────────────────
plt.figure(figsize=(12, 4))

plt.subplot(1, 2, 1)
plt.plot(history.history['accuracy'],     label='Training Accuracy')
plt.plot(history.history['val_accuracy'], label='Validation Accuracy')
plt.title('CRNN Model Accuracy')
plt.xlabel('Epoch')
plt.ylabel('Accuracy')
plt.legend()

plt.subplot(1, 2, 2)
plt.plot(history.history['loss'],     label='Training Loss')
plt.plot(history.history['val_loss'], label='Validation Loss')
plt.title('CRNN Model Loss')
plt.xlabel('Epoch')
plt.ylabel('Loss')
plt.legend()

plt.tight_layout()
plt.savefig('training_history.png', dpi=150)
print("-> Saved training curves to 'training_history.png'")
plt.show(block=False)
plt.pause(2)
plt.close()

# ─── 8. ADVANCED EVALUATION METRICS & CONFUSION MATRIX ───────────────────────
print("\n=== ADVANCED EVALUATION METRICS ===")
y_pred_probs   = model.predict(X_test)
y_pred_classes = np.argmax(y_pred_probs, axis=1)
y_true_classes = np.argmax(y_test, axis=1)

report = classification_report(
    y_true_classes, y_pred_classes,
    target_names=encoder.classes_, zero_division=0
)
print("\nClassification Report (Precision, Recall, F1-Score):")
print(report)

with open("evaluation_metrics.txt", "w") as f:
    f.write("=== CRNN CLASSIFICATION REPORT ===\n")
    f.write(report)
print("-> Saved report to 'evaluation_metrics.txt'")

cm = confusion_matrix(y_true_classes, y_pred_classes)
plt.figure(figsize=(12, 10))
sns.heatmap(cm, annot=True, fmt='d', cmap='Blues',
            xticklabels=encoder.classes_,
            yticklabels=encoder.classes_)
plt.title('Confusion Matrix: CRNN Dysarthric Phrase Decoder')
plt.ylabel('Actual Phrase Spoken')
plt.xlabel('Predicted Phrase')
plt.xticks(rotation=45, ha='right')
plt.tight_layout()
plt.savefig('confusion_matrix.png', dpi=300)
print("-> Saved Confusion Matrix to 'confusion_matrix.png'")

# 9. EXPORT MODEL (before plt.show so closing window never skips saving)
h5_path = "speech_model.h5"
model.save(h5_path)
print(f"9. Saved primary Keras model to '{h5_path}'")


# Save weights as a version-independent NumPy file
weights = model.get_weights()
np.save("speech_weights.npy", np.array(weights, dtype=object), allow_pickle=True)
print("Saved raw weight arrays to 'speech_weights.npy'")


print("10. Converting to TFLite (Raspberry Pi format)...")
converter = tf.lite.TFLiteConverter.from_keras_model(model)
converter.target_spec.supported_ops = [
    tf.lite.OpsSet.TFLITE_BUILTINS,
    tf.lite.OpsSet.SELECT_TF_OPS
]
converter._experimental_lower_tensor_list_ops = False
tflite_model = converter.convert()

tflite_path = "raspberry_pi_model.tflite"
with open(tflite_path, "wb") as f:
    f.write(tflite_model)

print("************************************************************")
print(f"SUCCESS! CRNN TFLite model saved at: {tflite_path}")
print("You can copy this file to your Raspberry Pi to run inferences!")
print("************************************************************")

# Show confusion matrix last - safe to close any time now
try:
    plt.show()
except KeyboardInterrupt:
    print("Plot window closed. All files already saved successfully!")
